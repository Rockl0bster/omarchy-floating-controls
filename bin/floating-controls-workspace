#!/usr/bin/env python3
"""Move a clicked titlebar window within its monitor's workspace range."""
import os
import json
import re
import subprocess
import sys
from pathlib import Path


def query(what):
    return json.loads(subprocess.check_output(["hyprctl", what, "-j"], text=True))


def main():
    if len(sys.argv) != 3 or not re.fullmatch(r"0x[0-9a-fA-F]+", sys.argv[1]) or sys.argv[2] not in ("prev", "next"):
        return 1
    address, direction = sys.argv[1:]
    client = next((c for c in query("clients") if c.get("address", "").lower() == address.lower()), None)
    if not client or not client.get("floating") or "omarchy-floating-workspace" not in client.get("tags", []):
        return 1
    workspace = client.get("workspace", {}).get("id", 0)
    monitor = next((m for m in query("monitors") if m.get("id") == client.get("monitor")), None)
    if not monitor or workspace <= 0:
        return 1
    state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "omarchy/monitor-workspaces"
    block = None
    for line in state.read_text().splitlines():
        fields = line.split("\t")
        if len(fields) >= 2 and fields[1] == monitor["name"] and fields[0].isdigit():
            block = int(fields[0])
            break
    if block is None:
        return 1
    low, high = block * 10 + 1, block * 10 + 10
    destination = workspace + (1 if direction == "next" else -1)
    if not low <= workspace <= high or not low <= destination <= high:
        return 0
    expression = f'hl.dsp.window.move({{ window = "address:{address}", workspace = {destination}, follow = false }})'
    subprocess.run(["hyprctl", "dispatch", expression], check=True, stdout=subprocess.DEVNULL)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.SubprocessError):
        raise SystemExit(1)
